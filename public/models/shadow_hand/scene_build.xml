<mujoco model="robot hand build scene">
  <include file="hand_free.xml"/>

  <option gravity="0 0 -9.81"/>
  <statistic extent="0.5"/>

  <default>
    <default class="block">
      <!-- condim 4 + friction 0.9: grips, and lets go cleanly when stacking (4/4 stacks in the release tests) -->
      <geom density="500" condim="4" priority="1" friction="0.9 0.005 0.0005"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 1.5"/>
    <light pos="0.3 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" pos="0 0 -0.75" size="0 0 0.05" type="plane" rgba="0.2 0.3 0.4 1"/>
    <geom name="table" type="box" size="0.35 0.45 0.02" pos="0.2 0 -0.02" rgba="0.55 0.45 0.35 1" friction="1 0.01 0.001"/>

    <body name="hand_target" mocap="true" pos="-0.2 0 0.15" quat="1 0 1 0"/>

    <!-- 5 cm cubes and a 16 x 4 x 4 cm beam (long side across, so the fingers close over its short side). -->
    <body name="cube1" pos="0.08 -0.18 0.025"><freejoint/><geom class="block" type="box" size="0.025 0.025 0.025" rgba="0.85 0.25 0.2 1"/></body>
    <body name="cube2" pos="0.08 -0.08 0.025"><freejoint/><geom class="block" type="box" size="0.025 0.025 0.025" rgba="0.2 0.45 0.85 1"/></body>
    <body name="cube3" pos="0.08 0.08 0.025"><freejoint/><geom class="block" type="box" size="0.025 0.025 0.025" rgba="0.3 0.7 0.35 1"/></body>
    <body name="cube4" pos="0.08 0.18 0.025"><freejoint/><geom class="block" type="box" size="0.025 0.025 0.025" rgba="0.9 0.75 0.2 1"/></body>
    <body name="plank" pos="0.0 0 0.02"><freejoint/><geom class="block" type="box" size="0.02 0.08 0.02" rgba="0.6 0.4 0.8 1"/></body>
  </worldbody>

  <equality>
    <weld body1="hand_target" body2="rh_forearm" solref="0.02 1"/>
    <!-- Grip assist: off until the fingers close around a block, then the block is held like by a magnet. -->
    <weld name="grip_cube1" body1="rh_palm" body2="cube1" active="false"/>
    <weld name="grip_cube2" body1="rh_palm" body2="cube2" active="false"/>
    <weld name="grip_cube3" body1="rh_palm" body2="cube3" active="false"/>
    <weld name="grip_cube4" body1="rh_palm" body2="cube4" active="false"/>
    <weld name="grip_plank" body1="rh_palm" body2="plank" active="false"/>
  </equality>
</mujoco>
