<mujoco model="robot hand pick scene">
  <include file="hand_free.xml"/>

  <option gravity="0 0 -9.81"/>
  <statistic extent="0.5"/>

  <worldbody>
    <light pos="0 0 1.5"/>
    <light pos="0.3 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" pos="0 0 -0.75" size="0 0 0.05" type="plane" rgba="0.2 0.3 0.4 1"/>
    <geom name="table" type="box" size="0.35 0.45 0.02" pos="0.2 0 -0.02" rgba="0.55 0.45 0.35 1" friction="1 0.01 0.001"/>

    <!-- The hand follows this invisible target through a soft weld. -->
    <body name="hand_target" mocap="true" pos="-0.2 0 0.15" quat="1 0 1 0"/>

    <body name="ball" pos="0.15 -0.1 0.035">
      <freejoint/>
      <geom type="sphere" size="0.035" rgba="0.85 0.25 0.2 1" density="300" condim="6" priority="1" friction="1.2 0.02 0.002"/>
    </body>
    <body name="cube" pos="0.15 0.1 0.025">
      <freejoint/>
      <geom type="box" size="0.025 0.025 0.025" rgba="0.2 0.45 0.85 1" density="300" condim="6" priority="1" friction="1.2 0.02 0.002"/>
    </body>
    <body name="can" pos="0.28 0 0.025">
      <freejoint/>
      <geom type="cylinder" size="0.03 0.025" rgba="0.9 0.75 0.2 1" density="300" condim="6" priority="1" friction="1.2 0.02 0.002"/>
    </body>
  </worldbody>

  <equality>
    <weld body1="hand_target" body2="rh_forearm" solref="0.02 1"/>
  </equality>
</mujoco>
